Screen {
    background: $background;
    color: $text;
}

#body, #chat-log {
    height: 1fr;
}

#chat-log {
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

.startup {
    padding: 1;
    color: $text-muted;
}

.user-message-row {
    height: auto;
    margin-top: 1;
    padding: 0 1;
    background: $surface;
}

.user-prompt {
    width: 2;
    height: 1;
    color: $accent;
}

.user-message {
    width: 1fr;
    background: transparent;
}

AssistantReply {
    height: auto;
    margin: 1 0;
    padding: 0 1;
}

AssistantReply Markdown {
    height: auto;
    margin: 0;
    padding: 0;
    background: transparent;
}

AssistantReply .copy-mode {
    height: 1;
    min-width: 1;
    padding: 0;
    border: none;
    background: transparent;
    color: $text-muted;
}

AssistantReply .copy-mode:focus {
    background: $surface;
    color: $text;
}

#live-status {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

#input-bar {
    height: auto;
    padding: 0 1;
}

#composer {
    height: auto;
    background: $surface;
}

#prompt-indicator {
    width: 3;
    height: 1;
    padding: 0 0 0 1;
    color: $accent;
}

#chat-input {
    width: 1fr;
    border: none;
    padding: 0 1 0 0;
    background: $surface;
}

#chat-input:focus {
    border: none;
}

#command-menu {
    height: auto;
    max-height: 7;
    padding: 0 1;
    color: $text-muted;
}

#chat-status {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#body Button {
    border-top: none;
    border-bottom: none;
}

#body Button:focus {
    background: $panel;
    color: $text;
    text-style: reverse;
}

#approval-drawer {
    height: auto;
    margin: 0 1;
}
