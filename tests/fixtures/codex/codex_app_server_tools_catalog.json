{
  "description": "Codex app-server Responses tool catalog shapes for bridge conversion regression.",
  "source": "codex-cli 0.147 coding turn tool shapes: function tools + host tools (local_shell, web_search, freeform custom apply_patch).",
  "tools": [
    {
      "type": "function",
      "name": "shell",
      "description": "Runs a shell command and returns its output.",
      "parameters": {
        "type": "object",
        "properties": {
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "workdir": {
            "type": "string"
          }
        },
        "required": [
          "command"
        ],
        "additionalProperties": false
      }
    },
    {
      "type": "custom",
      "name": "apply_patch",
      "description": "Freeform apply_patch tool (Codex apply_patch_tool_type=freeform / fallback model metadata).",
      "format": {
        "type": "text"
      }
    },
    {
      "type": "local_shell"
    },
    {
      "type": "web_search"
    },
    {
      "type": "function",
      "name": "update_plan",
      "description": "Update the current step plan.",
      "parameters": {
        "type": "object",
        "properties": {
          "plan": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "type": "function",
      "name": "view_image",
      "description": "Attach a local image for visual inspection.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "type": "function",
      "name": "list_dir",
      "description": "List directory entries.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "grep_files",
        "description": "Search file contents.",
        "parameters": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "pattern"
          ]
        }
      }
    }
  ]
}
